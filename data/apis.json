{
 "version": 1,
 "apis": [
  {
   "id": "ksv-gateway",
   "name": "KSV gateway",
   "type": "gateway",
   "base_url": "http://127.0.0.1:4000",
   "health": "",
   "auth": "header",
   "env_key": "GATEWAY_TOKEN",
   "enabled": true,
   "auth_header": "x-gateway-token",
   "routes": [
    "/api",
    "/api/chat"
   ]
  },
  {
   "id": "khoem-ai-api",
   "name": "KHOEM_AI API",
   "type": "ai",
   "base_url": "http://127.0.0.1:8790",
   "health": "/health",
   "auth": "none",
   "env_key": "",
   "enabled": true
  },
  {
   "id": "ai-backend",
   "name": "KHOEM AI backend",
   "type": "ai",
   "base_url": "http://127.0.0.1:8787",
   "health": "/api/health",
   "auth": "header",
   "env_key": "KHOEM_API_KEY",
   "enabled": true,
   "auth_header": "x-api-key",
   "routes_url": "/api/routes/all",
   "repo": "KHOEM-AI/AI"
  },
  {
   "id": "ai-ui",
   "name": "KHOEM AI UI",
   "type": "ui",
   "base_url": "http://127.0.0.1:5175",
   "health": "",
   "auth": "none",
   "env_key": "",
   "enabled": true,
   "repo": "KHOEM-AI/AI"
  },
  {
   "id": "iqai-media",
   "name": "IQ-AI media",
   "type": "media",
   "base_url": "http://127.0.0.1:8799/api/v1",
   "health": "",
   "auth": "bearer",
   "env_key": "IQAI_TOKEN",
   "enabled": true
  },
  {
   "id": "mqtt-broker",
   "name": "MQTT broker (device telemetry)",
   "type": "mqtt",
   "base_url": "",
   "health": "",
   "auth": "",
   "env_key": "MQTT_BROKER_URL",
   "enabled": true
  },
  {
   "id": "ksv-api",
   "name": "KSV platform API",
   "type": "platform",
   "base_url": "http://127.0.0.1:3000/api/v1",
   "auth": "bearer",
   "repo": "KHOEM-AI/KSV",
   "note": "port 3000 from Postman guide, not verified",
   "enabled": true
  }
 ]
}